# Enter these in Render Environment. Never commit real values.
PORT=10000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Empty = bundled user-provided CSV dataset in SQLite. Set a PostgreSQL URL to switch storage.
DATABASE_URL=
DATA_SOURCE_LABEL=
# Optional protected HTTP query endpoint. Generate a random token before enabling it.
DEMO_API_TOKEN=
